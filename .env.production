# The compressed build (F rec 10, flipped 31 Aug when the payload math turned):
# `vite build` reads the Draco `-compressed.glb` siblings written by
# `npm run compress`, through three's own wasm decoder (emitted hashed into
# dist/assets by Vite). Dev stays on the raw GLBs so `npm run prep` iterates
# without a compress step. See src/pipeline/ResourcesLoader.js (COMPRESSED / modelUrl).
VITE_COMPRESSED=1

# The public origin, for the absolute URLs Open Graph needs (og:url, og:image,
# canonical) — read at build by vite.config.js, never bundled. Live since
# 3 Sep 2026 (Cloudflare Workers static assets, the domain bought the same
# night). A build environment variable of the same name on the host wins.
SITE_URL=https://michaelyeh.dev
