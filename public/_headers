# Cloudflare Pages response headers (Phase 6, 3 Sep 2026). Vite copies this
# file to the root of dist/ untouched. Rules accumulate: a path matching
# several blocks gets all their headers.
#
# The cache rules rest on two facts about the URLs:
#   - everything under /assets/ carries a Vite content hash in its name
#     (the bundle, the CSS, three's Draco decoder pair);
#   - everything under /models/, /fonts/ and /projects/ is fetched with
#     ?v=<content hash> from src/core/staticUrl.js (tools/lib/static-versions.mjs
#     computes it at build; check-site fails on a bare URL).
# So all of it is immutable for a year, and a deploy that changes a file
# changes its URL. The HTML is the one thing that must revalidate every
# load, or a deploy would not be live until the old copy expired.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/projects/*
  Cache-Control: public, max-age=31536000, immutable

# Bare names, so a day: a new icon or preview image is live tomorrow.
/favicon.svg
  Cache-Control: public, max-age=86400

/og.jpg
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
